# 업비트 실거래/시뮬레이션에 사용할 키 값을 이 파일에 기입한 후
# `cp .env.example .env`로 복사하여 사용하세요. 실제 배포 시에는 절대 Git에 커밋하지 마세요.

# 업비트에서 발급한 Access Key
UPBIT_ACCESS_KEY=

# 업비트에서 발급한 Secret Key (보안을 위해 절대 공개하지 마세요)
UPBIT_SECRET_KEY=

# (선택) 업비트 네트워크 연결 허용 여부 (0 = 비활성화)
UPBIT_ENABLE_NETWORK=1

# (선택) 업비트 API 기본 URL - 샌드박스나 프록시를 사용할 경우 변경
UPBIT_BASE_URL=https://api.upbit.com

# 대시보드 로그인 이메일 (기본값을 그대로 둘 경우 아래 계정으로 로그인합니다)
DASHBOARD_USERNAME=sado0809@example.com
DASHBOARD_PASSWORD=honges08!!

# (선택) 2단계 인증을 건너뛰는 관리자 계정 (기본값: sadovseva3454@gmail.com / honges08!!)
# 기본값을 변경하려면 아이디와 해시된 비밀번호를 입력하세요. `python -m backend.security`를
# 이용하면 새 비밀번호 해시를 생성할 수 있습니다.
DASHBOARD_ADMIN_USERNAME=
DASHBOARD_ADMIN_PASSWORD_HASH=
# (호환) 부득이하게 평문 비밀번호를 입력해야 한다면 아래 변수에 작성하면 됩니다.
# 애플리케이션이 안전한 해시로 변환해 메모리에만 보관하지만, 보안상 사용을 권장하지 않습니다.
DASHBOARD_ADMIN_PASSWORD=

# (선택) Google Authenticator용 기본 TOTP 시크릿. 비워두면 초기 로그인 시 2단계 인증이 비활성화됩니다.
DASHBOARD_TOTP_SECRET=JBSWY3DPEHPK3PXP
# (선택) 2단계 인증 기본 활성화 여부 (0 = 비활성화, 1 = 활성화)
DASHBOARD_TOTP_ENABLED=1

# (선택) 초기 계정이 이메일 인증된 상태인지 여부 (1 = 인증 완료, 0 = 인증 필요)
DASHBOARD_EMAIL_VERIFIED=1

# (선택) 개발 환경에서 이메일 인증 코드를 API 응답으로 노출할지 여부 (1 = 노출, 0 = 숨김)
AUTH_DEBUG_EXPOSE_CODES=1

# (선택) 발급된 대시보드 토큰의 유효 시간(초)
AUTH_TOKEN_TTL_SECONDS=43200
# (선택) HTTPS 환경에서만 쿠키를 전송하고 싶다면 1로 설정하세요 (0 = 일반 HTTP 허용)
AUTH_COOKIE_SECURE=0

# (선택) 업비트 HTTP 타임아웃 (초). 네트워크가 느릴 때 값을 늘려 안정성을 높일 수 있습니다.
UPBIT_HTTP_TIMEOUT=12

# (선택) 업비트 API 호출 속도 제한. 네트워크 불안정 시 값을 낮춰 재시도/폴백을 줄일 수 있습니다.
UPBIT_RATE_LIMIT_PER_SECOND=24
UPBIT_RATE_LIMIT_PER_MINUTE=720

# (선택) 대시보드에 표시할 회사/포트폴리오 이름
DASHBOARD_TITLE=Sado Trade Bot

# (선택) 이메일 인증 코드를 전송할 SMTP 서버 정보
# SMTP_HOST, SMTP_USERNAME, SMTP_PASSWORD, SMTP_FROM 값을 채우면 회원가입 시 자동으로 메일을 발송합니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
SMTP_TIMEOUT=10

# (선택) Synology Chat 웹훅 URL - 자동매매 체결/경고를 채팅으로 알림
# 아래 예시는 반드시 본인 회사/개인 채널의 토큰으로 교체하세요.
# 예시:
# SADO_CHAT_WEBHOOK=http://honges08.iptime.org:5000/webapi/entry.cgi?api=SYNO.Chat.External&method=incoming\
#   &version=2&token=YOUR_TOKEN
SADO_CHAT_WEBHOOK=

# (선택) 오토파일럿 한 사이클당 분석할 최대 종목 수 (기본값 60, 범위 5~200)
AUTOPILOT_MAX_MARKETS_PER_CYCLE=60

# (선택) 로그인 직후 자동으로 오토파일럿을 기동할지 여부 (1=자동 시작, 0=수동)
AUTOPILOT_AUTO_START=1

# (선택) 오토파일럿 기본 구성값
# AUTOPILOT_DEFAULT_CAPITAL=20000000
# AUTOPILOT_DEFAULT_POLL_INTERVAL=120
# AUTOPILOT_DEFAULT_RISK_APPETITE=0.55
# AUTOPILOT_DEFAULT_MAX_POSITION=0.25
# AUTOPILOT_DEFAULT_MIN_CONFIDENCE=50
# AUTOPILOT_DEFAULT_BASE=KRW
# AUTOPILOT_DEFAULT_INTERVAL=minute60
# AUTOPILOT_DEFAULT_RECOMMENDATION_INTERVAL=minute60
# AUTOPILOT_DEFAULT_MAX_MARKETS=120
# AUTOPILOT_DEFAULT_MAX_TRADES=1
# AUTOPILOT_DEFAULT_AUTO_SELECT=1
# AUTOPILOT_DEFAULT_INCLUDE_PORTFOLIO=1
# AUTOPILOT_DEFAULT_INCLUDE_WARNINGS=0
# AUTOPILOT_DEFAULT_MARKET=KRW-BTC
